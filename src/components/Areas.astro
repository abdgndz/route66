---
import Icon from './Icon.astro';
import { areas, testCentres } from '../data/site';
---

<section class="section section--alt" id="areas">
  <div class="wrap grid">
    <div class="section-head">
      <p class="eyebrow">Areas we cover</p>
      <h2>Based in Hadlow, covering West Kent</h2>
      <p class="lead">
        We pick up from home, school, college or work across these towns and villages. Not on the list? Message us.
        We can often still help.
      </p>
    </div>
    <div class="cols">
      <div>
        <h3>Towns and villages</h3>
        <ul class="areas">
          {
            areas.map((a) => (
              <li>
                <Icon name="pin" size={16} />
                {a}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="centres">
        <h3>Test centres we use</h3>
        <ul>
          {testCentres.map((c) => <li>{c}</li>)}
        </ul>
        <p class="small">The nearest test centres to Tonbridge are Tunbridge Wells and Sevenoaks. We practise on the roads around the centre you book.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 56px;
    }
  }
  .cols {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 640px) {
    .cols {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  h3 {
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 16px;
  }
  .areas li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .areas :global(svg) {
    color: var(--red);
    flex: none;
  }
  .centres {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px;
    align-self: start;
  }
  .centres ul {
    display: grid;
    gap: 6px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 12px;
  }
  .small {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
