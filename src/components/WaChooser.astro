---
import Icon from './Icon.astro';
import { instructors, waLink, whatsappText } from '../data/site';
---

<dialog class="chooser" id="wa-chooser" aria-labelledby="wa-chooser-title">
  <div class="inner">
  <div class="head">
    <h2 id="wa-chooser-title">Who would you like to message?</h2>
    <button type="button" class="close" data-close aria-label="Close">
      <Icon name="close" />
    </button>
  </div>
  <ul>
    {
      instructors.map((i) => (
        <li>
          <a href={waLink(i.phoneE164, whatsappText(i.transmission))} target="_blank" rel="noopener" data-close>
            <span class={`dot dot--${i.id}`} aria-hidden="true">
              <Icon name="whatsapp" size={20} />
            </span>
            <span class="txt">
              <strong>
                {i.label} · {i.transmission}
              </strong>
              <span>{i.id === 'female' ? 'Automatic lessons, nervous drivers, refreshers' : 'Manual lessons, motorway, test-day car hire'}</span>
            </span>
            <Icon name="arrow" size={20} class="go" />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="foot">Opens WhatsApp with a short message ready to send.</p>
  </div>
</dialog>

<style>
  .chooser {
    width: min(440px, calc(100vw - 32px));
    border: 0;
    border-radius: var(--radius-lg);
    padding: 0;
    overscroll-behavior: contain;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 64px rgb(11 37 69 / 0.25);
  }
  .inner {
    padding: 22px;
  }
  .chooser::backdrop {
    background: rgb(11 37 69 / 0.45);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  h2 {
    font-size: 1.5rem;
  }
  .close {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--navy);
    cursor: pointer;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  a {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    min-height: 64px;
  }
  a:hover {
    border-color: var(--wa-dark);
    background: #f2fbf5;
    color: var(--ink);
  }
  .dot {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--wa-dark);
  }
  .txt {
    display: grid;
    flex: 1;
    line-height: 1.3;
  }
  .txt span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  :global(.go) {
    color: var(--muted);
  }
  .foot {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
