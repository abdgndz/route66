---
// Asks before Google Analytics loads (UK GDPR / PECR: analytics cookies need consent).
---

<div class="cookie" id="cookie-banner" role="region" aria-label="Cookie choice" hidden>
  <p>
    Can we use analytics cookies to see how people find this site? Nothing loads unless you say yes.{" "}
    <a href="/privacy#cookies">More info</a>
  </p>
  <div class="actions">
    <button type="button" class="btn btn--ghost" data-consent="denied">No thanks</button>
    <button type="button" class="btn btn--accept" data-consent="granted">Accept</button>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    z-index: 90;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(16px + env(safe-area-inset-bottom));
    max-width: 560px;
    margin-inline: auto;
    display: grid;
    gap: 12px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgb(11 37 69 / 0.18);
    font-size: 0.98rem;
  }
  .cookie[hidden] {
    display: none;
  }
  .actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }
  .actions .btn {
    flex: 1 1 0;
    min-height: 44px;
  }
  .btn--accept {
    --btn-bg: var(--navy);
  }
</style>
