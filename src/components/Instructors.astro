---
import Icon from './Icon.astro';
import V from './V.astro';
import { instructors, waLink, telLink, whatsappText } from '../data/site';
---

<section class="section section--alt" id="instructors">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Meet your instructors</p>
      <h2>Two instructors, one small local school</h2>
      <p class="lead">Manual with our male instructor, automatic with our female instructor. Message whichever suits you.</p>
    </div>
    <div class="cards">
      {
        instructors.map((i) => (
          <article class="card">
            <div class="top">
              <h3>
                {i.label} · {i.transmission}
              </h3>
              <p class="role">{i.role}</p>
            </div>
            <p class="bio">
              <V v={i.bio} />
            </p>
            <ul class="chips">
              {i.tags.map((t) => (
                <li class:list={['chip', { 'chip--accent': t === 'Female instructor' }]}>{t}</li>
              ))}
            </ul>
            <p class="car">
              <Icon name="car" size={20} />
              <V v={i.car} />
            </p>
            <div class="ctas">
              <a
                class="btn btn--wa"
                href={waLink(i.phoneE164, whatsappText(i.transmission))}
                target="_blank"
                rel="noopener"
              >
                <Icon name="whatsapp" />
                WhatsApp
              </a>
              <a class="btn btn--ghost" href={telLink(i.phoneE164)} aria-label={`Call the ${i.label.toLowerCase()} on ${i.phoneDisplay}`}>
                <Icon name="phone" />
                <V v={i.phoneDisplay} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 860px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Column layout so the buttons sit at the bottom of both cards. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 32px);
  }
  .role {
    font-weight: 600;
    color: var(--navy);
    margin-top: 4px;
  }
  .bio {
    color: var(--ink);
  }
  .car {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .car :global(svg) {
    flex: none;
    color: var(--blue);
  }
  .ctas {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 480px) {
    .ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
