---
import { services } from '../data/site';
interface Props {
  heading?: string;
  showLink?: boolean;
}
const { heading = 'Who we teach', showLink = true } = Astro.props;
---

<section class="section" id="lessons">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Lessons</p>
      <h2>{heading}</h2>
      <p class="lead">Every lesson is one-to-one in a dual-control car, planned around you and your test centre.</p>
    </div>
    <ul class="grid">
      {
        services.map((s, i) => (
          <li class="item">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
    {
      showLink && (
        <p class="more">
          <a href="/lessons">How lessons, courses and test-day hire work</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .item {
    background: var(--surface);
    padding: 24px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .num {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--red);
    font-size: 1rem;
    letter-spacing: 0.08em;
  }
  .item p {
    color: var(--muted);
  }
  .more {
    margin-top: 24px;
    font-weight: 600;
  }
</style>
