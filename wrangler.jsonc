{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "route66-driving-school",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "route66drivingschool.co.uk", "custom_domain": true },
    { "pattern": "www.route66drivingschool.co.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  }
}
